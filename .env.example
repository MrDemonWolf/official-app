# Copy to .env and fill in your own site.
# WordPress content API (posts, portfolio)
EXPO_PUBLIC_WORDPRESS_API_URL=https://example.com/wp-json/wp/v2
EXPO_PUBLIC_WORDPRESS_USER_ID=1

# MrDemonWolf plugin. Push and forms share one namespace from plugin 2.0.0
# onwards; the old tailsignal/v1 and packrelay/v1 namespaces are gone.
EXPO_PUBLIC_MRDW_API_URL=https://example.com/wp-json/mrdw/v1

# The form the contact screen submits to. Gravity Forms and WPForms use the
# numeric form ID; Divi uses "pageId:formIndex", e.g. 42:0.
EXPO_PUBLIC_MRDW_FORM_ID=1

# Apple Developer team, required to sign the notification service extension.
APPLE_TEAM_ID=
